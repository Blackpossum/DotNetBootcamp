<Window x:Class="DotNetBootcamp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title=".NET Bootcamp — Beginner to Expert (.NET 10 / C# 14)"
        Icon="app.ico"
        Width="1280" Height="820"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#0f1117">
    <Grid>
        <wv2:WebView2 x:Name="WebView" DefaultBackgroundColor="#0F1117" />
        <TextBlock x:Name="LoadingText"
                   Text="Loading .NET Bootcamp…"
                   Foreground="#8b91a7" FontSize="16"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Window>
