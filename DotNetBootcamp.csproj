<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DotNetBootcamp</RootNamespace>
    <AssemblyTitle>.NET Bootcamp</AssemblyTitle>
    <Product>.NET Bootcamp</Product>
    <Description>Offline bootcamp for .NET 10 and C# 14 — 12 modules, 53 lessons.</Description>
    <Version>1.0.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DefaultItemExcludes>$(DefaultItemExcludes);dist\**;build\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <!-- also embedded so the window/taskbar shows it -->
  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <!-- Ship the course content next to the exe -->
  <ItemGroup>
    <None Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
